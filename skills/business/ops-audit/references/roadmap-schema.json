{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ops-audit roadmap","description":"Executable invariants are implemented by scripts/validator.py; this schema is the portable contract.","type":"object","required":["roadmap_id","business","date","revision","incomplete","stopping_point","consent","exclusions","cards","first_move","first_automation","first_automation_reason","pending_feedback","owner_approval"],"properties":{"roadmap_id":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},"business":{"type":"string","minLength":1},"date":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"incomplete":{"type":"boolean"},"stopping_point":{"type":["string","null"]},"consent":{"type":"array","items":{"type":"object","required":["category","scope"],"properties":{"category":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1}}}},"exclusions":{"type":"array","items":{"type":"object","required":["category","declared_root_or_account"],"properties":{"category":{"type":"string","minLength":1},"declared_root_or_account":{"type":"string","minLength":1}}}},"cards":{"type":"array","items":{"$ref":"#/$defs/card"}},"first_move":{"type":["string","null"]},"first_automation":{"type":["string","null"]},"first_automation_reason":{"type":["string","null"]},"pending_feedback":{"type":"array","items":{"$ref":"#/$defs/feedback"}},"owner_approval":{"type":["object","null"],"required":["roadmap_id","roadmap_revision","approved_by","approved_at"],"properties":{"roadmap_id":{"type":"string","minLength":1},"roadmap_revision":{"type":"integer","minimum":1},"approved_by":{"type":"string","minLength":1},"approved_at":{"type":"string","minLength":1}},"additionalProperties":false}},"$defs":{"card":{"type":"object","required":["id","version","group","action","hours_per_month","hourly_value","annual_labor_value","causal_path","evidence","existing_coverage","gaps","approval","intervention","diagnosis","proof","verdict"],"properties":{"id":{"type":"strin