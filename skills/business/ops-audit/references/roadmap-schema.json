{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops-audit roadmap",
  "description": "The owner's plan and the audit cards behind it. Executable invariants are implemented by scripts/validator.py; this schema is the portable contract.",
  "type": "object",
  "required": ["roadmap_id", "business", "date", "revision", "incomplete", "stopping_point", "consent", "exclusions", "cards", "plan", "first_move", "first_automation", "first_automation_reason", "owner_approval"],
  "properties": {
    "roadmap_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "business": {"type": "string", "minLength": 1},
    "date": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "incomplete": {"type": "boolean"},
    "stopping_point": {"type": ["string", "null"]},
    "consent": {"type": "array", "items": {"type": "object", "required": ["category", "scope"], "properties": {"category": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}},
    "exclusions": {"type": "array", "items": {"type": "object", "required": ["category", "declared_root_or_account"], "properties": {"category": {"type": "string", "minLength": 1}, "declared_root_or_account": {"type": "string", "minLength": 1}}}},
    "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "plan": {
      "description": "Null while the audit is incomplete. Every card appears in exactly one step. The first main-lane step is first_move. The first automation step is first_automation.",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/plan"}]
    },
    "focus": {"description": "Null for a whole-operation audit; otherwise the owner's words for the area this audit covers, as in \"email triage\".", "type": ["string", "null"]},
    "extensions": {"description": "What the owner could add to the agent and what each addition would unlock, in the owner's words.", "type": "array", "items": {"type": "object", "required": ["add", "unlocks"], "properties": {"add": {"type": "string", "minLength": 1}, "unlocks": {"type": "string", "minLength": 1}}}},
    "first_move": {"type": ["string", "null"]},
    "first_automation": {"type": ["string", "null"]},
    "first_automation_reason": {"type": ["string", "null"]},
    "owner_approval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/owner_approval"}]}
  },
  "$defs": {
    "owner_approval": {
      "type": "object",
      "required": ["roadmap_id", "roadmap_revision", "approved_by", "approved_at"],
      "properties": {"roadmap_id": {"type": "string", "minLength": 1}, "roadmap_revision": {"type": "integer", "minimum": 1}, "approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["steps"],
      "properties": {"steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}}
    },
    "step": {
      "description": "One thing that will happen, in the owner's own terms. Its kind (move, automation, hold) comes from the card's verdict.",
      "type": "object",
      "required": ["card", "lane", "title", "do", "you_decide", "done_when", "never"],
      "properties": {
        "card": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "lane": {"enum": ["main", "parallel"]},
        "title": {"type": "string", "minLength": 1},
        "do": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "you_decide": {"type": "string", "minLength": 1},
        "done_when": {"type": "string", "minLength": 1},
        "never": {"type": ["string", "null"]}
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "version", "action", "hours_per_month", "hourly_value", "annual_labor_value", "causal_path", "evidence", "existing_coverage", "gaps", "approval", "intervention", "diagnosis", "proof", "verdict"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "version": {"type": "integer", "minimum": 1},
        "action": {"type": "string", "minLength": 1},
        "hours_per_month": {"type": ["number", "null"], "minimum": 0},
        "hourly_value": {"type": ["number", "null"], "minimum": 0},
        "annual_labor_value": {"type": ["number", "null"], "minimum": 0},
        "causal_path": {"type": "object", "required": ["trigger", "collection", "judgment", "action", "destination", "read_back", "failure_visibility"]},
        "evidence": {"type": "array", "items": {"type": "object", "required": ["label", "claim", "source"], "properties": {"label": {"enum": ["observed", "owner-reported", "inferred"]}, "claim": {"type": "string"}, "source": {"type": "string"}}}},
        "existing_coverage": {"type": "object", "required": ["definitions", "recent_runs", "outputs", "failure_visibility"]},
        "gaps": {"type": "array", "items": {"type": "string"}},
        "approval": {"type": "object", "required": ["required", "approver", "gate"]},
        "intervention": {"enum": ["remove", "simplify", "deterministic rule", "leverage move", "agent automation"]},
        "diagnosis": {"type": "string", "minLength": 1},
        "proof": {"description": "What would show the action worked, in audit words. The step's done_when is its plain twin.", "type": "string", "minLength": 1},
        "verdict": {"enum": ["keep human", "leverage move", "automate with an agent"]}
      }
    }
  }
}
