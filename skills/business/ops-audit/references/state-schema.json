{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ops-audit state",
  "description": "Roadmap identity, consent, evidence status, change record, approval, and step status. Executable invariants are implemented by scripts/validator.py.",
  "type": "object",
  "required": ["roadmap_id", "revision", "consent", "exclusions", "evidence", "changes", "incomplete", "stopped_at", "owner_approval", "steps"],
  "properties": {
    "roadmap_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "consent": {"type": "array", "items": {"type": "object", "required": ["category", "scope"], "properties": {"category": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}},
    "exclusions": {"type": "array", "items": {"type": "object", "required": ["category", "declared_root_or_account"]}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["category", "status", "source"], "properties": {"category": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "limit": {"type": ["string", "null"]}}}},
    "changes": {
      "description": "One entry per revision after the first: what the owner asked for in chat and what the agent changed.",
      "type": "array",
      "items": {"type": "object", "required": ["revision", "date", "summary"], "properties": {"revision": {"type": "integer", "minimum": 2}, "date": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}}}
    },
    "incomplete": {"type": "boolean"},
    "stopped_at": {"type": ["string", "null"]},
    "owner_approval": {"oneOf": [{"type": "null"}, {"$ref": "roadmap-schema.json#/$defs/owner_approval"}]},
    "steps": {
      "description": "Keyed by card id. A missing entry means the first status. Moves and automations use proposed, approved, done. Holds use holding, ended. The note carries the owner's words for approved and what was done and how it was checked for done.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "note", "date"],
        "properties": {
          "status": {"enum": ["proposed", "approved", "done", "holding", "ended"]},
          "note": {"type": "string", "minLength": 1},
          "date": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
